<!DOCTYPE html>
<html lang="he" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VoxOsint - Global Reconnaissance & Cyber Intelligence</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik+Black&family=Ultra&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --neon-blue: #ffffff;
            --neon-green: #ffffff;
            --neon-orange: #ffffff;
            --dark-bg: #000000;
            --panel-bg: rgba(0, 0, 0, 0.98);
            --border-blue: rgba(255, 255, 255, 0.4);
            --border-green: rgba(255, 255, 255, 0.7);
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: 'Rubik Black', 'Ultra', impact, sans-serif;
            overflow-x: hidden;
            user-select: none;
            letter-spacing: 1px;
        }

        .heavy-font {
            font-family: 'Rubik Black', 'Ultra', impact, sans-serif;
            text-transform: uppercase;
        }

        /* Glitch / Distressed Text Effect matching B&W theme */
        .glitch-text {
            position: relative;
            color: #ffffff;
            font-weight: 900;
            letter-spacing: 6px;
            text-shadow: 
                2px 0 #ffffff,
                -2px 0 #666666,
                0 0 10px rgba(255, 255, 255, 0.9);
            animation: glitch-anim 2.5s infinite linear alternate-reverse;
        }

        @keyframes glitch-anim {
            0% {
                text-shadow: 2px 0 #ffffff, -2px 0 #444444, 0 0 12px rgba(255, 255, 255, 0.9);
            }
            20% {
                text-shadow: -2px 0 #cccccc, 2px 0 #333333, 0 0 5px rgba(255, 255, 255, 0.6);
            }
            40% {
                text-shadow: 3px -1px #ffffff, -3px 1px #555555, 1px 0 15px rgba(255, 255, 255, 0.8);
            }
            60% {
                text-shadow: -1px 2px #dddddd, 1px -2px #222222, 0 0 8px rgba(255, 255, 255, 0.7);
            }
            80% {
                text-shadow: 2px -2px #ffffff, -2px 2px #777777, 0 0 20px rgba(255, 255, 255, 0.8);
            }
            100% {
                text-shadow: -2px 0 #444444, 2px 0 #ffffff, 0 0 10px rgba(255, 255, 255, 0.9);
            }
        }

        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            background: #000000;
        }

        #login-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(25px);
            transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .lock-card {
            background: rgba(0, 0, 0, 0.98);
            border: 3px solid #ffffff;
            padding: 50px 45px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 0 60px rgba(255, 255, 255, 0.25), inset 0 0 20px rgba(255, 255, 255, 0.1);
            width: 480px;
            max-width: 92vw;
            position: relative;
            overflow: hidden;
        }

        .lock-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            transform: rotate(45deg);
            animation: scanline 4s linear infinite;
        }

        @keyframes scanline {
            0% { transform: translateY(-100%) rotate(45deg); }
            100% { transform: translateY(100%) rotate(45deg); }
        }

        .logo-container {
            width: 140px;
            height: 140px;
            margin: 0 auto 20px auto;
            filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.7));
            animation: pulseLogo 3s infinite alternate;
        }

        @keyframes pulseLogo {
            0% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.5)); }
            100% { transform: scale(1.08); filter: drop-shadow(0 0 35px rgba(255, 255, 255, 0.9)); }
        }

        .lock-title {
            font-size: 50px;
            line-height: 1;
            margin: 0 0 8px 0;
            letter-spacing: 6px;
            color: #ffffff;
        }

        .lock-subtitle {
            color: #cccccc;
            font-size: 11px;
            margin-bottom: 35px;
            letter-spacing: 4px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .passcode-wrapper {
            position: relative;
            margin-bottom: 25px;
        }

        .login-input {
            width: 100%;
            background: #000000;
            border: 2px solid #ffffff;
            color: #ffffff;
            padding: 18px;
            border-radius: 12px;
            font-size: 22px;
            text-align: center;
            outline: none;
            box-sizing: border-box;
            letter-spacing: 8px;
            box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .login-input:focus {
            border-color: #ffffff;
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.8), inset 0 0 20px rgba(255, 255, 255, 0.4);
        }

        .framed-btn {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff;
            border: 2px solid #ffffff;
            padding: 18px;
            border-radius: 12px;
            font-size: 15px;
            cursor: pointer;
            letter-spacing: 3px;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2), inset 0 0 10px rgba(255, 255, 255, 0.1);
            position: relative;
            z-index: 2;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
        }

        .framed-btn:hover {
            background: #ffffff;
            color: #000000;
            border-color: #ffffff;
            box-shadow: 0 0 45px rgba(255, 255, 255, 0.9), inset 0 0 20px rgba(0, 0, 0, 0.2);
            transform: translateY(-3px) scale(1.02);
            text-shadow: none;
        }

        .error-msg {
            color: #ffffff;
            background: #111111;
            border: 1px solid #ffffff;
            padding: 8px;
            border-radius: 6px;
            font-size: 12px;
            margin-top: 18px;
            display: none;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
            animation: shake 0.4s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        #main-app {
            display: none;
            padding: 35px;
            max-width: 1450px;
            margin: 0 auto;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 2px solid #ffffff;
            background: rgba(0, 0, 0, 0.98);
            backdrop-filter: blur(15px);
            padding: 22px 32px;
            border-radius: 16px;
            margin-bottom: 35px;
            box-shadow: 0 0 35px rgba(255, 255, 255, 0.2);
        }

        .brand h1 {
            margin: 0;
            font-size: 42px;
            letter-spacing: 6px;
        }

        .tool-tab {
            background: #000000;
            border: 2px solid #555555;
            color: #aaaaaa;
            padding: 16px 28px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 13px;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
        }

        .tool-tab:hover, .tool-tab.active {
            background: #ffffff;
            border-color: #ffffff;
            color: #000000;
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.7);
            transform: translateY(-3px);
            text-shadow: none;
        }

        .workspace {
            background: rgba(0, 0, 0, 0.98);
            border: 2px solid #ffffff;
            border-radius: 18px;
            padding: 50px;
            box-shadow: 0 0 50px rgba(255, 255, 255, 0.15);
            min-height: 500px;
            position: relative;
            backdrop-filter: blur(20px);
        }

        .tool-panel {
            display: none;
        }

        .tool-panel.active {
            display: block;
        }

        .osint-input {
            background: #000000;
            border: 2px solid #777777;
            color: #ffffff;
            padding: 18px 24px;
            border-radius: 12px;
            font-size: 18px;
            outline: none;
            transition: 0.3s;
            box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.1);
        }

        .osint-input:focus {
            border-color: #ffffff;
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.6), inset 0 0 15px rgba(255, 255, 255, 0.2);
        }

        .results-box {
            background: #000000;
            border: 2px solid #ffffff;
            border-radius: 12px;
            padding: 30px;
            font-size: 14px;
            line-height: 1.8;
            color: #ffffff;
            max-height: 400px;
            overflow-y: auto;
            display: none;
            box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.15);
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
        }
    </style>
</head>
<body>

    <!-- Pitch Black Background Canvas with White Wavy Grid -->
    <canvas id="bg-canvas"></canvas>

    <div id="login-screen">
        <div class="lock-card heavy-font">
            <!-- Anonymous Emblem SVG Logo in Black & White -->
