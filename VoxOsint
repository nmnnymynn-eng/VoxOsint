    <div id="main-app" class="heavy-font">
        <header>
            <div class="flex items-center gap-5">
                <div class="w-14 h-14">
                    <svg viewBox="0 0 200 200" width="100%" height="100%">
                        <circle cx="100" cy="100" r="95" fill="#000000" stroke="#ffffff" stroke-width="5"/>
                        <circle cx="100" cy="100" r="62" fill="none" stroke="#ffffff" stroke-width="3"/>
                        <ellipse cx="100" cy="100" rx="62" ry="25" fill="none" stroke="#ffffff" stroke-width="2"/>
                        <ellipse cx="100" cy="100" rx="30" ry="62" fill="none" stroke="#ffffff" stroke-width="2"/>
                        <path d="M 68,175 L 82,102 L 100,128 L 118,102 L 132,175 Z" fill="#ffffff"/>
                        <polygon points="100,102 96,138 100,148 104,138" fill="#000000"/>
                        <text x="100" y="82" font-family="'Rubik Black', sans-serif" font-size="28" font-weight="900" fill="#ffffff" text-anchor="middle">?</text>
                    </svg>
                </div>
                <div>
                    <h1 class="glitch-text">VOXOSINT</h1>
                    <span class="text-xs text-white tracking-widest opacity-80">GLOBAL CYBER RECONNAISSANCE PLATFORM</span>
                </div>
            </div>
            <div class="bg-black border-2 border-white text-white px-6 py-2 rounded-xl text-xs shadow-[0_0_15px_rgba(255,255,255,0.3)]">
                STATUS: ENCRYPTED CORE ACTIVE
            </div>
        </header>

        <div class="flex gap-4 flex-wrap mb-8">
            <button class="tool-tab active" onclick="switchTool('discord')">Discord OSINT</button>
            <button class="tool-tab" onclick="switchTool('custom')">Custom Lookup</button>
