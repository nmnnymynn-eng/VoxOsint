    <script>
        function verifyCode() {
            const val = document.getElementById('passcode-input').value.trim();
            const err = document.getElementById('error-msg');
            const screen = document.getElementById('login-screen');
            const app = document.getElementById('main-app');

            if (val === 'x1') {
                screen.style.opacity = '0';
                screen.style.transform = 'scale(1.1)';
                setTimeout(() => {
                    screen.style.display = 'none';
                    app.style.display = 'block';
                }, 700);
            } else {
                err.style.display = 'block';
            }
        }

        document.getElementById('passcode-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') verifyCode();
        });

        function switchTool(toolName) {
            document.querySelectorAll('.tool-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tool-panel').forEach(p => p.classList.remove('active'));

            if (event && event.target) {
                event.target.classList.add('active');
            }
            document.getElementById('panel-' + toolName).classList.add('active');
        }

        async function runScan(type) {
            const inputEl = document.getElementById(type + '-input');
            const loadingEl = document.getElementById('loading-' + type);
            const resultsEl = document.getElementById('results-' + type);

            if (!inputEl || !loadingEl || !resultsEl) return;
            const inputVal = inputEl.value.trim();

            loadingEl.style.display = 'block';
            resultsEl.style.display = 'none';

            let output = `[+] TARGET: ${inputVal || 'AUTO_SELF'}\n`;
            output += `[+] SCAN TIMESTAMP: ${new Date().toISOString()}\n`;
            output += `--------------------------------------------------\n`;

            try {
                if (type === 'discord') {
                    if (!/^\d{17,20}$/.test(inputVal)) {
                        output += `[ERROR] Invalid Discord ID format! Please enter a valid 17-20 digit Snowflake ID.`;
                    } else {
                        const epoch = 1420070400000n;
                        const idBig = BigInt(inputVal);
                        const timestamp = Number((idBig >> 22n) + epoch);
                        const creationDate = new Date(timestamp);

                        output += `[SUCCESS] Real Snowflake ID Decoded!\n`;
                        output += `[ACCOUNT CREATED]: ${creationDate.toUTCString()} (${creationDate.toISOString()})\n`;
                        output += `[UNIX TIMESTAMP]: ${timestamp} ms\n`;
                        output += `[WORKER ID]: ${(idBig & 0x3E0000n) >> 17n}\n`;
                        output += `[PROCESS ID]: ${(idBig & 0x1F000n) >> 12n}\n`;
                        output += `[INCREMENTAL]: ${idBig & 0xFFFn}\n`;
                        output += `[PROFILE CDN]: https://cdn.discordapp.com/avatars/${inputVal}/`;
                    }
                } else if (type === 'ip') {
                    const targetIp = inputVal ? inputVal : '';
                    const res = await fetch(`https://ipapi.co/${targetIp}/json/`);
                    if (!res.ok) throw new Error('Failed to query IP API');
                    const data = await res.json();

                    output += `[SUCCESS] Live Telemetry Retrieved!\n`;
                    output += `[IP ADDRESS] : ${data.ip}\n`;
                    output += `[CITY / REGION] : ${data.city}, ${data.region} (${data.region_code})\n`;
                    output += `[COUNTRY] : ${data.country_name} (${data.country_code_iso3})\n`;
                    output += `[POSTAL CODE] : ${data.postal || 'N/A'}\n`;
                    output += `[LAT / LONG] : ${data.latitude}, ${data.longitude}\n`;
                    output += `[TIMEZONE] : ${data.timezone}\n`;
                    output += `[ASN / NETWORK] : ${data.asn} (${data.org || data.asn})\n`;
                    output += `[ISP] : ${data.network || data.org}`;
                } else if (type === 'custom') {
                    const domain = inputVal.replace(/^(https?:\/\/)?/, '').split('/')[0];
                    if (!domain) throw new Error('Invalid domain specified');

                    const res = await fetch(`https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(domain)}&type=A`, {
                        headers: { 'Accept': 'application/dns-json' }
                    });
                    const data = await res.json();

                    output += `[SUCCESS] DNS Records Resolved via Cloudflare!\n`;
                    output += `[DOMAIN]: ${domain}\n`;
                    if (data.Answer && data.Answer.length > 0) {
                        data.Answer.forEach(ans => {
                            output += `[RECORD A]: ${ans.name} -> ${ans.data} (TTL: ${ans.TTL}s)\n`;
                        });
                    } else {
                        output += `[NOTICE] No direct A records found or status: ${data.Status}\n`;
                    }
                } else if (type === 'breach') {
                    const domain = inputVal.replace(/^(https?:\/\/)?/, '').split('/')[0];
                    if (!domain) throw new Error('Invalid domain specified');

                    const res = await fetch(`https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(domain)}&type=MX`, {
                        headers: { 'Accept': 'application/dns-json' }
                    });
                    const data = await res.json();

                    output += `[SUCCESS] Mail Server Infrastructure Scanned!\n`;
                    output += `[DOMAIN]: ${domain}\n`;
                    if (data.Answer && data.Answer.length > 0) {
                        data.Answer.forEach(ans => {
                            output += `[MX SERVER]: ${ans.data}\n`;
                        });
                    } else {
                        output += `[STATUS] No active MX records detected for domain.\n`;
                    }
                }
            } catch (err) {
                output += `[ERROR] Failed to query target: ${err.message}`;
            } finally {
                loadingEl.style.display = 'none';
                resultsEl.style.display = 'block';
                resultsEl.innerText = output;
            }
        }

        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let step = 0;
        function animateGrid() {
            ctx.fillStyle = '#000000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
            ctx.lineWidth = 1.5;

            const rows = 22;
            const cols = 32;
            const spacingX = canvas.width / cols;
            const spacingY = canvas.height / rows;

            step += 0.025;

            for (let r = 0; r <= rows; r++) {
                ctx.beginPath();
                for (let c = 0; c <= cols; c++) {
                    const x = c * spacingX;
                    const wave = Math.sin(c * 0.45 + step) * Math.cos(r * 0.35 + step) * 28;
                    const y = (r * spacingY) + wave;

                    if (c === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            }

            for (let c = 0; c <= cols; c++) {
                ctx.beginPath();
                for (let r = 0; r <= rows; r++) {
                    const x = c * spacingX;
                    const wave = Math.sin(c * 0.45 + step) * Math.cos(r * 0.35 + step) * 28;
                    const y = (r * spacingY) + wave;

                    if (r === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            }

            requestAnimationFrame(animateGrid);
        }
        animateGrid();
    </script>
</body>
</html>
